# Mosaic application
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://mosaic:mosaic@localhost:5436/mosaic

# SMTP (Mailpit defaults for local Compose)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_FROM=Mosaic <no-reply@mosaic.local>
SMTP_USER=
SMTP_PASSWORD=
