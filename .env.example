# Mosaic application
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://mosaic:mosaic@localhost:5436/mosaic

# SMTP (Mailpit defaults for local Compose)
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_FROM=Mosaic <no-reply@mosaic.local>
SMTP_USER=
SMTP_PASSWORD=

# Airbyte self-managed public API (server-only)
# Keep these empty while working only with fixture accounts.
AIRBYTE_API_URL=
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_WORKSPACE_ID=
AIRBYTE_DESTINATION_ID=
AIRBYTE_REQUEST_TIMEOUT_MS=5000
# Supported values: 1, 2, 3, 4, 6, 8, 12, or 24. Airbyte evaluates the generated cron schedule in UTC.
AIRBYTE_SYNC_FREQUENCY_HOURS=6
# Set only after the GA4 workspace OAuth credential override is installed in Airbyte.
AIRBYTE_GA4_OAUTH_READY=false

# Superset embedded dashboard service (server-only except the public embed origin)
SUPERSET_URL=
SUPERSET_SERVICE_USERNAME=
SUPERSET_SERVICE_PASSWORD=
SUPERSET_GA4_DASHBOARD_ID=
SUPERSET_REQUEST_TIMEOUT_MS=5000
# Set only after embedded mode and an explicit Mosaic allowed domain are configured.
SUPERSET_EMBED_READY=false
